# ---------------------------------------------------------------------------
# 虚拟环境：由 启动.bat 自己创建（python -m venv .venv，再用清华源装依赖）
# ---------------------------------------------------------------------------
.venv/

# Python 运行产物
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------------------------
# 本机跑出来的状态与日志：换台电脑就该重新生成，提交上去只会互相覆盖
# ---------------------------------------------------------------------------
logs/
*.log

# 访问触发的后台更新：锁（logs 下）/ 结果 / 实时进度，页头横幅读的就是后两个
*.lock
zhuiju/data/refresh_state.json
zhuiju/data/refresh_progress.json

# 原子写入留下的中间文件（hot.json.tmp、catalog.json.tmp、resources.json.part）
*.tmp
*.part

# 搜过的关键词日志——记录的是这台电脑上都搜过什么，属于隐私
zhuiju/data/queries.jsonl

# 有时效的缓存：猜你想搜结果、/s/ 落地页快照、图片代理已登记的 URL
zhuiju/data/cache/

# 后台统计的数据库（WAL 模式会带 -wal / -shm 两个侧文件）——
# 里面是"哪个 IP 在什么时候搜了什么"，属于本机隐私
zhuiju/data/stats.db
zhuiju/data/stats.db-wal
zhuiju/data/stats.db-shm

# Emby STRM 那一套：采集数据库、访问触发的状态与进度、导出的目录树和分卷包。
# strm/ 与 strm_zips/ 是几万个文件（近一年 × 多源 × 多线路必然是这个量级），
# 全部由 tools/collect_strm.py 重新生成 —— 提交上去既把仓库撑爆，
# 又会让每台机器自己的采集结果互相覆盖
zhuiju/data/strm.db
zhuiju/data/strm.db-wal
zhuiju/data/strm.db-shm
zhuiju/data/strm_state.json
zhuiju/data/strm_progress.json
strm/
strm_zips/

# 后台口令配置文件：明文 password + 会话签名密钥，换台机器就该重新生成
zhuiju/data/admin.json

# 后台页面上能改的运行设置（现在只有"每天几点算新的一天"）：这台机器的状态，
# 默认值在 zhuiju/settings.py 里，提交上来只会让仓库跟着每个人的偏好来回改
zhuiju/data/settings.json

# 部署时写本机解释器/端口/口令的小文件（模板是 zhuiju.env.example）：
# 里面可能有口令与 secret_key，跟 admin.json 一样不能提交
zhuiju.env

# 维护脚本的草稿与中间产物
.probe/

# ---------------------------------------------------------------------------
# 上游数据：内容属于 awesome-zhuiju-free 仓库本身，每天更新都会重新下载，
# 不在这个库里再分发一份（tools/build_catalog.py 走 gh-proxy 镜像链重拉）
# data/geo/ 是 IP 归属地库(10.6MB)、国家轮廓底图与算出来的坐标表，由 tools/fetch_geo.py 拉；
# 换台机器重下一条命令就有，不必跟着仓库走 14MB 二进制
# ---------------------------------------------------------------------------
data/upstream/
data/cache/
data/geo/

# ---------------------------------------------------------------------------
# 以下三份**要提交**，别顺手加进忽略名单：
#   zhuiju/data/sources.json    实测可用的 10 个检索接口（逐个探测才结论）
#   zhuiju/data/templates.json  双关键词差分验证通过的站内搜索路径
#   zhuiju/data/catalog.json    资源站目录，新克隆没有它则目录与直达全空
# ---------------------------------------------------------------------------

# 本地环境变量（端口、TMDB key 之类，别把密钥提交上来）
.env
!.env.example

# Windows 资源管理器噪声
Thumbs.db
desktop.ini

# 前台（web/）是一次构建就交付的东西：
#   node_modules/     仍然忽略 —— 几万个文件，谁提交谁后悔
#   package-lock.json 这次**要提交**：界面是构建产物的一部分，锁文件不在，
#                     换台机器 `npm install` 就会拿到不同版本的 HeroUI，产物跟着变
node_modules/
package-lock.json
!web/package-lock.json
