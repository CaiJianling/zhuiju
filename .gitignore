# ---------------------------------------------------------------------------
# 虚拟环境：由 启动.bat 自己创建（python -m venv .venv，再用清华源装依赖）
# ---------------------------------------------------------------------------
.venv/

# Python 运行产物
__pycache__/
*.py[cod]
.pytest_cache/

# ---------------------------------------------------------------------------
# 本机跑出来的状态与日志：换台电脑就该重新生成，提交上去只会互相覆盖
# ---------------------------------------------------------------------------
logs/
*.log

# 访问触发的后台更新：锁（logs 下）/ 结果 / 实时进度，页头横幅读的就是后两个
*.lock
zhuiju/data/refresh_state.json
zhuiju/data/refresh_progress.json

# 原子写入留下的中间文件（hot.json.tmp、catalog.json.tmp、resources.json.part）
*.tmp
*.part

# 搜过的关键词日志——记录的是这台电脑上都搜过什么，属于隐私
zhuiju/data/queries.jsonl

# 有时效的缓存：猜你想搜结果、/s/ 落地页快照、图片代理已登记的 URL
zhuiju/data/cache/

# 后台统计的数据库（WAL 模式会带 -wal / -shm 两个侧文件）——
# 里面是"哪个 IP 在什么时候搜了什么"，属于本机隐私
zhuiju/data/stats.db
zhuiju/data/stats.db-wal
zhuiju/data/stats.db-shm

# 后台口令配置文件：明文 password + 会话签名密钥，换台机器就该重新生成
zhuiju/data/admin.json

# 维护脚本的草稿与中间产物
.probe/

# ---------------------------------------------------------------------------
# 上游数据：内容属于 awesome-zhuiju-free 仓库本身，每天更新都会重新下载，
# 不在这个库里再分发一份（tools/build_catalog.py 走 gh-proxy 镜像链重拉）
# ---------------------------------------------------------------------------
data/upstream/
data/cache/

# ---------------------------------------------------------------------------
# 以下三份**要提交**，别顺手加进忽略名单：
#   zhuiju/data/sources.json    实测可用的 10 个检索接口（逐个探测才结论）
#   zhuiju/data/templates.json  双关键词差分验证通过的站内搜索路径
#   zhuiju/data/catalog.json    资源站目录，新克隆没有它则目录与直达全空
# ---------------------------------------------------------------------------

# 本地环境变量（端口、TMDB key 之类，别把密钥提交上来）
.env
!.env.example

# Windows 资源管理器噪声
Thumbs.db
desktop.ini
